TEXT 0 -448 Left 4 ;OPEN_WEIGHT - 01 - Power chain start-up : +3.3V -> TPS61086 -> +6V -> LT3042 -> +5VA
TEXT 0 -376 Left 2 ;Switching simulation of the complete start-up (600 ms): +5VA needs about 5 x R9 x C14 = 550 ms to settle at 5 V. Q1 kept OFF (P3 high) as after reset.\nLong run (about 30 min, 2.8 GB of waveforms). Set .tran 0 25m to look at the boost soft-start only.
TEXT -72 176 Left 1 ;Host +3.3V (J1 pin 1)
TEXT 400 176 Left 1 ;AD7190 DVDD
TEXT 800 -112 Left 1 ;Wurth 7447785004
TEXT 1000 -112 Left 1 ;PMEG2010AEH
TEXT 560 400 Left 1 ;MODE = GND\n(Power Save Mode)
TEXT 0 -240 Left 3 ;TPS61086 BOOST  +3.3V -> +6V   (schematic page 6)
TEXT 1792 560 Left 1 ;C14 = TAJA225K016 (tantalum)
TEXT 3040 272 Left 1 ;C4 C12 C3 C26 = AD7190 AVDD decoupling
TEXT 3712 256 Left 1 ;AD7190 AVDD
TEXT 1600 -240 Left 3 ;LT3042 LDO  +6V -> +5VA   (schematic page 5)
TEXT 3856 528 Left 1 ;AD7190 P3 (GPOCON)
TEXT 4064 16 Left 1 ;SI2303CDS\n(approx. model)
TEXT 4448 720 Left 1 ;load cell\n(350 ohm bridge)
TEXT 4976 800 Left 1 ;AD7190 BPDSW\n(low-side switch)
TEXT 3856 -240 Left 3 ;LOAD-CELL EXCITATION   (schematic page 4)
TEXT 0 960 Left 2 !.tran 0 600m\n.options method=gear trtol=7 reltol=0.003
TEXT 0 1040 Left 2 !.param Rbridge=350
TEXT 0 1080 Left 2 !.save V(+3.3V) V(+6V) V(+5VA) V(SS) V(SET) V(PG) I(L1)
TEXT 0 1120 Left 2 !.meas tran V6_final AVG V(+6V) FROM 590m TO 600m\n.meas tran V6_max MAX V(+6V)\n.meas tran T6_90 WHEN V(+6V)=5.436 RISE=1\n.meas tran IL_peak MAX I(L1)\n.meas tran T_PG WHEN V(PG)=3 RISE=1\n.meas tran V5_25m FIND V(+5VA) AT 25m\n.meas tran T5_99 WHEN V(+5VA)=4.95 RISE=1\n.meas tran T5_999 WHEN V(+5VA)=4.995 RISE=1\n.meas tran V5_final AVG V(+5VA) FROM 590m TO 600m
