    # - variable: 'RELEASE_TITLE_1.0.2'
    #   command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --title-only --version 1.0.2'
    # - variable: 'RELEASE_BODY_1.0.2'
